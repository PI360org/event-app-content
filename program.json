  "venue": {
    "address": "Schanzenstraße 6-20, Gebäude 1.21, 51063 Köln, Germany",
    "intro": "Industry Days 2027 take place at the BASE in the Carlswerk quarter of Köln-Mülheim, a former industrial site that is now home to creative companies, culture and sport. About ten minutes on foot from Köln-Mülheim station.",
    "name": "BASE",
    "travel": [
      [
        "By train",
        "ICE and IC trains stop at Köln Hbf and Köln Messe/Deutz. From there, S6, S11, RE1 or RE5 take you to Köln-Mülheim in a few minutes, then it is a 10-minute walk."
      ],
      [
        "By tram and bus",
        "Tram 4 to Keupstraße (5 min walk), trams 13 and 18 to Bahnhof Köln-Mülheim (10 min walk), or bus 150 to Köln Carlswerkstraße (2 min walk)."
      ],
      [
        "From Cologne/Bonn Airport (CGN)",
        "S19, RE6 or RB27 to Köln Messe/Deutz, change to S6, S11, RE1 or RE5 to Köln-Mülheim. Plan about 40 minutes door to door, or about 20 minutes by taxi."
      ],
      [
        "From Düsseldorf Airport (DUS)",
        "RE1 or RE5 from Düsseldorf Flughafen station run directly to Köln-Mülheim in about 35 minutes. The S11 also runs direct from the terminal but takes longer."
      ]
    ]
  },
